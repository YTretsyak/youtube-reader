# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.
# Consumed by docker-compose.yml — see docs/specification.md sections 8-9.

# MongoDB. Inside Compose this points at the `mongo` service.
MONGO_CONNECTION_STRING=mongodb://mongo:27017

# RabbitMQ. Broker between `api` and `transcript-service`. Inside Compose this
# points at the `rabbitmq` service (default guest credentials for local dev only).
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672

# LLM — OpenAI-compatible endpoint. Interim provider: GitHub Models (free
# prototyping tier). Swap LLM_BASE_URL to retarget Ollama/Groq/OpenAI — no code change.
LLM_BASE_URL=https://models.github.ai/inference
# For GitHub Models this is a GitHub Personal Access Token with `models: read`
# (NOT a Claude/ChatGPT subscription). Any placeholder value works for local Ollama.
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
